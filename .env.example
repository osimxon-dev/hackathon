# PostgreSQL ulanish satri (Neon / Supabase / lokal Postgres)
DATABASE_URL=postgresql://user:password@host:5432/navbat?sslmode=require

# Baza bo'sh bo'lsa demo shifokorlar va qabullar qo'shilsinmi (true/false)
SEED_DEMO_DATA=true

# Registratura paneli (/admin) paroli. Kodga yozilmaydi, faqat muhit o'zgaruvchisida
ADMIN_PASSWORD=

# Faollik jurnali uchun MongoDB (Atlas). Berilmasa jurnal o'chiq turadi
MONGODB_URI=
MONGODB_DB=navbat
